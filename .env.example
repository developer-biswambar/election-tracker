# Your Gmail address
GMAIL_USER=you@gmail.com

# Gmail App Password (not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on your Google account
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Comma-separated list of recipient emails
RECIPIENT_EMAILS=biswambarp43@gmail.com,another@example.com

# How often to check for changes (in seconds). Default: 300 (5 minutes)
CHECK_INTERVAL_SECONDS=300

# How often to send a full results digest (in seconds). Default: 600 (10 minutes)
# Set to 0 to disable digest notifications entirely.
DIGEST_INTERVAL_SECONDS=600

# ── Twilio WhatsApp ────────────────────────────────────────────────────────────
# Find these at https://console.twilio.com — leave blank to disable WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Sandbox sender (default). Replace with your approved number for production.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Comma-separated recipient numbers (include country code, no spaces)
WHATSAPP_RECIPIENTS=+919876543210,+447911123456
